# ── PostgreSQL (used by docker-compose db service and app service) ────────────
POSTGRES_USER=agile
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agile_team_helper

# ── Application ───────────────────────────────────────────────────────────────
# For docker-compose: DATABASE_URL is assembled by the compose file from
# POSTGRES_* vars above. Set it explicitly only when running against an
# external database.
DATABASE_URL=postgresql+asyncpg://agile:changeme@localhost:5432/agile_team_helper

# Enable SQLAlchemy query echo and FastAPI debug mode
DEBUG=false
